# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Razorpay Server Credentials (NEVER expose Key Secret or Webhook Secret to client)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Public Key ID for client Checkout hydration (also returned by /api/payments/capabilities)
VITE_RAZORPAY_KEY_ID=""

# Optional Firebase Admin Service Account JSON string (if running outside GCP ADC)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Kiosk Hardware Authentication Secret (used by Windows Electron kiosk via X-Kiosk-Secret)
KIOSK_API_SECRET="dev-kiosk-secret-change-in-prod"

# Temp Upload Retention TTL in minutes (default: 30)
UPLOAD_TTL_MINUTES="30"
